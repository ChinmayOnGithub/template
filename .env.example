# ==============================================================================
# Application Configuration Baseline
# Copy this file to .env.local for local development.
# Never commit real secrets, API keys, or credentials to git.
# ==============================================================================

# Application Environment
# Options: development, test, production
NODE_ENV=development

# Base Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Session Secrets
# Generate random 32-byte secret: openssl rand -base64 32
AUTH_SECRET=replace_with_secure_random_string_in_env_local

# Database Connection (If applicable)
# Example: postgresql://user:password@localhost:5432/dbname?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_dev

# Billing Provider (never use mock in production)
# Options: mock (development/test only), razorpay
BILLING_PROVIDER=mock
BILLING_WEBHOOK_SECRET=replace_with_provider_webhook_secret_in_env_local
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SaaS Admin Portal Integration (Optional)
ADMIN_PORTAL_URL=http://localhost:4000
ADMIN_PORTAL_CLIENT_ID=product_local_client
ADMIN_PORTAL_CLIENT_SECRET=replace_with_product_client_secret_in_env_local
# Development/test HMAC secret only. Production must use the portal's RSA public key.
ADMIN_PORTAL_SIGNING_SECRET=replace_with_development_signing_secret_in_env_local
ADMIN_PORTAL_SIGNING_PUBLIC_KEY=

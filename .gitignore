# ==============================================================================
# Universal .gitignore Superset
# Covers common artifacts across Web, Node, Python, Java, Rust, Go, C/C++, Mobile
# ==============================================================================

# ------------------------------------------------------------------------------
# Operating System & Editor Artifacts
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.directory
*~
*.swp
*.swo
*.swn
*.bak
*.tmp
*.temp

# ------------------------------------------------------------------------------
# IDE & Tool Metadata
# ------------------------------------------------------------------------------
# JetBrains
.idea/
*.iml
*.iws

# Visual Studio / Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.suo
*.user
*.userosscache
*.sln.docstates
*.ntvs*
*.njsproj
*.sln

# Sublime Text
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# Environment, Credentials & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
credentials.json
service-account*.json
.aws/
.gcloud/

# ------------------------------------------------------------------------------
# Logs & Diagnostic Dumps
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun.log*
lerna-debug.log*
crash.log
hs_err_pid*

# ------------------------------------------------------------------------------
# Node.js, JavaScript, TypeScript & Runtimes
# ------------------------------------------------------------------------------
node_modules/
.pnp
.pnp.js
.pnpm-store/
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# Web Frameworks (Next.js, React, Vite, Astro, Nuxt, SvelteKit)
# ------------------------------------------------------------------------------
.next/
out/
dist/
build/
.turbo/
.parcel-cache/
.cache/
.nuxt/
.output/
.svelte-kit/
.astro/

# ------------------------------------------------------------------------------
# Testing, Coverage & Playwright Artifacts
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*

# ------------------------------------------------------------------------------
# Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.tox/

# ------------------------------------------------------------------------------
# Java, Kotlin, Gradle & Maven
# ------------------------------------------------------------------------------
*.class
*.jar
*.war
*.ear
.gradle/
build/
target/
.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------------------------
# Rust & Cargo
# ------------------------------------------------------------------------------
target/
**/*.rs.bk

# ------------------------------------------------------------------------------
# Go
# ------------------------------------------------------------------------------
bin/
/vendor/

# ------------------------------------------------------------------------------
# C, C++, CMake & Native Build Systems
# ------------------------------------------------------------------------------
CMakeFiles/
CMakeCache.txt
CMakeOutput.log
CMakeError.log
cmake-build-*/
Makefile
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb
*.ilk
*.exp

# ------------------------------------------------------------------------------
# Mobile (Android, iOS, React Native, Flutter)
# ------------------------------------------------------------------------------
# Android
.cxx/
local.properties
*.apk
*.aab
.externalNativeBuild/

# iOS
DerivedData/
*.xcworkspace/xcuserdata
*.xcuserdatad
Pods/

# Flutter / Dart
.dart_tool/
.packages

# React Native / Expo
.expo/
web-build/

# ------------------------------------------------------------------------------
# Databases, Caches & Local Storage
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
dev.db*
dump.rdb

# ------------------------------------------------------------------------------
# Containers & Virtualization
# ------------------------------------------------------------------------------
*.cid
docker-compose.override.yml

# AI context index and task output
.agents/context/index.json
.agents/context/items.json
.agents/context/last-context.json
